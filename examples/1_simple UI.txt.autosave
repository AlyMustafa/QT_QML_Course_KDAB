import QtQuick
import QtQuick.Window

Window {
  visible: true
  width: 800
  height: 800

  Rectangle {
    anchors.fill: parent
    gradient: Gradient {
      GradientStop {
        position: 0.0
        color: "#F9B2D7"
      }
      GradientStop {
        position: 1.0
        color: "#CFECF3"
      }
    }
    Text {
      id: text
      text: qsTr("Hello Petter !")
      anchors.bottom: lineEdit.top
      anchors.horizontalCenter: parent.horizontalCenter
